# Copy the two lines below into simple-trader-api/.env (gitignored) and fill them in.
# Token: create a bot with @BotFather in Telegram. Chat id: run `python scripts/send_telegram_test.py --whoami`
# after sending your bot a message. For a channel later, use @channelname or the -100... id.
# Optional broadcast channel: TELEGRAM_CHANNEL_ID is its -100... id (private channel) or @name (public).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_ID=
